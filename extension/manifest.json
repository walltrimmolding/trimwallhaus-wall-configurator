{
  "manifest_version": 3,
  "name": "Wall Molding Calculator | TWH",
  "version": "1.1.0",
  "description": "Plan picture frames, French step corners, board and batten, accent walls and wainscoting with cut lists and live kit pricing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Wall Molding Calculator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://trimwallhaus.com/*"
  ]
}
